generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Identity & access
// ------------------------------------------------------------------
enum Role {
  PLAYER
  AGENT
  MENTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
  PENDING
}

model User {
  id           String     @id @default(cuid())
  phone        String     @unique
  passwordHash String
  role         Role       @default(PLAYER)
  status       UserStatus @default(ACTIVE)
  displayName  String
  vipLevel     Int        @default(1)
  /// Game ID. C2C-only merchants do not have a Game ID.
  playerNo     Int?       @unique
  panelId      Int?       @unique
  referralCode String     @unique
  /// Profile birthday — editable only once (Account Records).
  birthday     DateTime?
  birthdaySet  Boolean    @default(false)
  /// Optional withdraw PIN (hashed). Null = not set.
  withdrawPinHash String?
  referredById String?
  referredBy   User?      @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]     @relation("Referrals")
  giftRedemptions GiftCodeRedemption[]

  agentActive          Boolean @default(false) // C2C merchant active for orders
  referralAgentActive  Boolean @default(false) // Referral salary Agent program
  /// Admin opens "Transfer to balance" on agent salary UI (hidden when false).
  salaryTransferOpen   Boolean @default(false)
  /// Paisa amount of COMMISSION balance admin has approved for transfer (rest = hold).
  salaryApprovedPaisa  BigInt  @default(0)
  // Relative share of collection orders (e.g. 30/50/70). Normalized across active merchants.
  orderSharePct        Int     @default(100)
  walletsFilled        Int     @default(0)

  /// Per-player overrides (null = use global settings). Multipliers e.g. 1 = 1×, 5 = 5×.
  depositWagerOverride Float?
  bonusWagerOverride   Float?

  /// Consecutive daily-reward streak: last claimed day (1–7), 0 = never.
  dailyClaimStreak Int       @default(0)
  lastDailyClaimAt DateTime?

  /// VIP salary claims
  vipRewardClaimedLevel Int       @default(0)
  lastVipWeeklyAt       DateTime?
  lastVipMonthlyAt      DateTime?

  /// Last game bet — used for 7-day return / welcome-back bonus
  lastPlayedAt       DateTime?
  lastReturnBonusAt  DateTime?

  /// Bet Rebate: unlock timer after hitting min loss
  rebetUnlockAt     DateTime?
  lastRebetClaimAt  DateTime?

  // Sub-admin permission scopes. Empty for a full/super admin.
  adminScopes String[] @default([])

  // Marketing channel the user joined through, and the code that bound them.
  channelCode String?
  bindCode    String?
  ownedChannels Channel[] @relation("ChannelOwner")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts          LedgerAccount[]
  sessions          Session[]
  deposits          Deposit[]
  withdrawals       Withdrawal[]
  bonuses           Bonus[]
  agentAccounts     AgentAccount[]
  media             Media[]
  wheelSpins        WheelSpin[]
  ancestorEdges     ReferralEdge[]  @relation("Ancestor")
  descendantEdges   ReferralEdge[]  @relation("Descendant")
  commissionsEarned Commission[]    @relation("CommissionAgent")
  commissionsSource Commission[]    @relation("CommissionSource")
  ordersAsPlayer    CollectionOrder[] @relation("OrderPlayer")
  ordersAsAgent     CollectionOrder[] @relation("OrderAgent")
  gameRounds        GameRound[]
  crashBets         CrashBet[]
  wingoBets         WingoBet[]
  lotteryBets       LotteryBet[]
  rouletteBets      RouletteBet[]
  carRouletteBets   CarRouletteBet[]
  zooRouletteBets   ZooRouletteBet[]
  dragonTigerBets   DragonTigerBet[]
  sevenUpBets       SevenUpBet[]
  notifications     Notification[]
  freeCashClaims    FreeCashClaim[]

  @@index([role])
  @@index([referredById])
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String   @unique
  device           String?
  ip               String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime @default(now())

  @@index([userId])
}

// ------------------------------------------------------------------
// Ledger (double-entry) — all money moves through here
// ------------------------------------------------------------------
enum Bucket {
  MAIN
  BONUS
  FROZEN
  COMMISSION
}

enum SystemAccount {
  HOUSE
  BONUS_POOL
  GATEWAY_CLEARING
  AGENT_FLOAT
}

model LedgerAccount {
  id        String         @id @default(cuid())
  ownerId   String?
  owner     User?          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  bucket    Bucket?
  system    SystemAccount?
  currency  String         @default("PKR")
  balance   BigInt         @default(0)
  updatedAt DateTime       @updatedAt
  createdAt DateTime       @default(now())

  entries LedgerEntry[]

  @@unique([ownerId, bucket, currency])
  @@unique([system, currency])
  @@index([ownerId])
}

enum LedgerTxType {
  DEPOSIT
  WITHDRAWAL_FREEZE
  WITHDRAWAL_PAID
  WITHDRAWAL_UNFREEZE
  DEPOSIT_BONUS
  REGISTRATION_BONUS
  DAILY_BONUS
  COMMISSION
  WHEEL_PRIZE
  BONUS_RELEASE
  ADMIN_ADJUST
  GAME_BET
  GAME_WIN
  GAME_REFUND
  COLLECTION
}

enum LedgerTxStatus {
  POSTED
  VOID
}

model LedgerTransaction {
  id             String         @id @default(cuid())
  type           LedgerTxType
  status         LedgerTxStatus @default(POSTED)
  idempotencyKey String?        @unique
  referenceType  String?
  referenceId    String?
  createdById    String?
  meta           Json?
  createdAt      DateTime       @default(now())

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
}

enum EntryDirection {
  DEBIT
  CREDIT
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     String
  account       LedgerAccount     @relation(fields: [accountId], references: [id])
  direction     EntryDirection
  amount        BigInt
  createdAt     DateTime          @default(now())

  @@index([accountId, createdAt])
  @@index([transactionId])
}

// ------------------------------------------------------------------
// Payments (manual) — channels, deposits, withdrawals, media
// ------------------------------------------------------------------
enum PaymentMethod {
  JAZZCASH
  EASYPAISA
  BANK
  WEGARS
}

model PaymentChannel {
  id            String        @id @default(cuid())
  method        PaymentMethod
  accountNumber String
  accountTitle  String
  bankName      String?
  instructions  String?
  enabled       Boolean       @default(true)
  // When true: shown to C2C merchants for float top-up (bank accounts only).
  agentFloat    Boolean       @default(false)
  minAmount     BigInt        @default(0)
  maxAmount     BigInt        @default(0)
  priority      Int           @default(0)
  createdAt     DateTime      @default(now())

  deposits Deposit[]
}

enum TxnStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Deposit {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  amount         BigInt
  method         PaymentMethod
  channelId      String?
  channel        PaymentChannel? @relation(fields: [channelId], references: [id])
  agentAccountId String?
  agentAccount   AgentAccount?  @relation(fields: [agentAccountId], references: [id])
  senderAccount  String?
  trxId          String?
  receiptUrl     String?
  status         TxnStatus      @default(PENDING)
  agentId        String?
  rejectReason   String?
  idempotencyKey String?        @unique
  createdAt      DateTime       @default(now())
  processedById  String?
  processedAt    DateTime?

  commissions Commission[]
  collectionOrder CollectionOrder?

  @@index([userId])
  @@index([status])
  @@index([agentId])
}

model Withdrawal {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  amount         BigInt
  method         PaymentMethod
  accountDetails Json
  status         TxnStatus     @default(PENDING)
  agentId        String?
  trxId          String?
  payoutProofUrl String?
  wagerOk        Boolean       @default(false)
  rejectReason   String?
  /// When false, withdrawal stays on admin hold (not visible in C2C Pay On Behalf queue).
  /// Admin must release to C2C pool, or pay/reject themselves.
  c2cReleased    Boolean       @default(false)
  createdAt      DateTime      @default(now())
  processedById  String?
  processedAt    DateTime?

  @@index([userId])
  @@index([status])
  @@index([c2cReleased, status])
}

enum MediaKind {
  DEPOSIT_RECEIPT
  PAYOUT_PROOF
}

model Media {
  id        String    @id @default(cuid())
  ownerId   String?
  owner     User?     @relation(fields: [ownerId], references: [id])
  kind      MediaKind
  url       String
  mime      String
  size      Int
  createdAt DateTime  @default(now())
}

// ------------------------------------------------------------------
// Agent / C2C
// ------------------------------------------------------------------
model AgentAccount {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  method        PaymentMethod
  number        String
  holder        String
  enabled       Boolean       @default(false)
  awaitingReview Boolean      @default(true)
  createdAt     DateTime      @default(now())

  deposits Deposit[]

  @@index([userId])
  @@index([number])
}

enum OrderType {
  DEPOSIT
  WITHDRAW
}

enum OrderStatus {
  PENDING
  CHECKING
  PROCESSING
  SUCCESS
  FAIL
}

model CollectionOrder {
  id                String        @id @default(cuid())
  orderNo           String        @unique
  type              OrderType
  amount            BigInt
  reward            BigInt        @default(0)
  playerId          String?
  player            User?         @relation("OrderPlayer", fields: [playerId], references: [id])
  agentId           String?
  agent             User?         @relation("OrderAgent", fields: [agentId], references: [id])
  walletAccount     String?
  collectionAccount String?
  method            PaymentMethod?
  status            OrderStatus   @default(PENDING)
  frozenAmount      BigInt        @default(0)
  createdAt         DateTime      @default(now())
  // Set when player submits TID / proof — starts the merchant 1h confirm window
  submittedAt       DateTime?
  resolvedAt        DateTime?

  /// Admin overrode a merchant FAIL → credited player + cut float (shows as Manual Done).
  manualDone        Boolean       @default(false)

  // Pay-on-behalf (WITHDRAW orders): link to the withdrawal + payee snapshot + agent proof
  withdrawalId  String?
  depositId     String?       @unique
  deposit       Deposit?      @relation(fields: [depositId], references: [id])
  payeeName     String?
  payeeBank     String?
  senderAccount String?
  trxId         String?

  @@index([agentId])
  @@index([status])
}

// ------------------------------------------------------------------
// Referral & commission
// ------------------------------------------------------------------
model ReferralEdge {
  id           String @id @default(cuid())
  ancestorId   String
  ancestor     User   @relation("Ancestor", fields: [ancestorId], references: [id], onDelete: Cascade)
  descendantId String
  descendant   User   @relation("Descendant", fields: [descendantId], references: [id], onDelete: Cascade)
  level        Int

  @@unique([ancestorId, descendantId])
  @@index([descendantId])
  @@index([ancestorId])
}

enum CommissionStatus {
  ACCRUED
  PAID
  VOID
}

model Commission {
  id           String           @id @default(cuid())
  agentId      String
  agent        User             @relation("CommissionAgent", fields: [agentId], references: [id])
  sourceUserId String
  sourceUser   User             @relation("CommissionSource", fields: [sourceUserId], references: [id])
  depositId    String?
  deposit      Deposit?         @relation(fields: [depositId], references: [id])
  level        Int
  rateBps      Int
  amount       BigInt
  status       CommissionStatus @default(ACCRUED)
  createdAt    DateTime         @default(now())

  @@index([agentId])
}

/// One idempotent end-of-day commission calculation per player.
/// Amounts are based on cumulative deposited principal loss, not individual bets.
model DailyCommissionSettlement {
  id             String   @id @default(cuid())
  sourceUserId   String
  settlementDate String
  depositTarget  BigInt
  wageredTarget  BigInt
  wonTarget      BigInt
  lossTarget     BigInt
  lossDelta      BigInt
  settledAt      DateTime @default(now())

  @@unique([sourceUserId, settlementDate])
  @@index([settlementDate])
}

// ------------------------------------------------------------------
// Bonuses & engagement
// ------------------------------------------------------------------
enum BonusType {
  REGISTRATION
  DAILY_OPEN
  DEPOSIT_1
  DEPOSIT_2
  DEPOSIT_3
  DAILY_DEPOSIT
  REBET
  CASHBACK
  WHEEL
  RETURN
  FREE_CASH
  GIFT_CODE
}

enum BonusStatus {
  LOCKED
  ACTIVE
  RELEASED
  EXPIRED
}

model Bonus {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  type          BonusType
  amount        BigInt
  wagerRequired BigInt      @default(0)
  wagerProgress BigInt      @default(0)
  status        BonusStatus @default(ACTIVE)
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())

  @@index([userId])
}

model FreeCashClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId   String
  dayKey    String
  amount    BigInt
  createdAt DateTime @default(now())

  @@unique([userId, questId, dayKey])
  @@index([userId, dayKey])
}

model WheelPrize {
  id         String  @id @default(cuid())
  label      String
  color      String
  weight     Int
  isPhysical Boolean @default(false)
  wheel      String  @default("SPIN")
  order      Int     @default(0)

  spins WheelSpin[]
}

model WheelSpin {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  prizeId   String
  prize     WheelPrize @relation(fields: [prizeId], references: [id])
  amount    BigInt     @default(0)
  wheel     String     @default("SPIN")
  createdAt DateTime   @default(now())

  @@index([userId])
}

model CashbackTier {
  id      String  @id @default(cuid())
  name    String
  minLoss BigInt
  pct     Int
  maxClaim BigInt
  enabled Boolean @default(true)
  order   Int     @default(0)
}

enum OfferType {
  Deposit
  Cashback
  Festival
  Referral
}

model Offer {
  id      String    @id @default(cuid())
  title   String
  desc    String
  type    OfferType
  reward  String
  enabled Boolean   @default(true)
}

model Game {
  id       String  @id @default(cuid())
  slug     String  @unique
  title    String
  emoji    String
  color    String
  category String
  enabled  Boolean @default(true)
  winPct   Int     @default(90)
  tag      String?
  plays    Int     @default(0)
  ggr      BigInt  @default(0)
  order    Int     @default(0)
}

enum RoundState {
  ACTIVE
  CASHED_OUT
  BUST
}

model GameRound {
  id            String     @id @default(cuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  gameSlug      String
  bet           BigInt
  gridSize      Int        @default(25)
  minesCount    Int
  minePositions Int[]
  revealed      Int[]
  multiplier    Float      @default(0)
  state         RoundState @default(ACTIVE)
  payout        BigInt     @default(0)
  createdAt     DateTime   @default(now())
  endedAt       DateTime?

  @@index([userId])
  @@index([gameSlug])
  @@index([gameSlug, state])
}

enum CrashPhase {
  WAITING
  FLYING
  CRASHED
}

// Shared multiplayer Aviator/Crash round (server-authoritative).
model CrashRound {
  id            String     @id @default(cuid())
  gameSlug      String     @default("aviator")
  phase         CrashPhase @default(WAITING)
  crashPoint    Float
  waitingEndsAt DateTime
  startedAt     DateTime?
  crashedAt     DateTime?
  createdAt     DateTime   @default(now())
  bets          CrashBet[]

  @@index([gameSlug, phase])
  @@index([createdAt])
}

model CrashBet {
  id         String     @id @default(cuid())
  roundId    String
  round      CrashRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  slot       Int        @default(0)
  bet        BigInt
  autoAt     Float?
  cashoutAt  Float?
  payout     BigInt     @default(0)
  state      RoundState @default(ACTIVE)
  createdAt  DateTime   @default(now())
  endedAt    DateTime?

  @@unique([roundId, userId, slot])
  @@index([userId])
  @@index([roundId, state])
}

enum WingoPhase {
  BETTING
  LOCKED
  REVEAL
}

enum WingoBetType {
  number
  green
  red
  violet
  big
  small
}

// Shared multiplayer WinGo round per mode (30s / 1min / 3min / 5min).
model WingoRound {
  id            String     @id @default(cuid())
  mode          String
  period        String
  phase         WingoPhase @default(BETTING)
  resultNumber  Int?
  bettingEndsAt DateTime
  lockedEndsAt  DateTime?
  revealEndsAt  DateTime?
  createdAt     DateTime   @default(now())
  bets          WingoBet[]

  @@unique([mode, period])
  @@index([mode, phase])
  @@index([mode, createdAt])
}

model WingoBet {
  id        String       @id @default(cuid())
  roundId   String
  round     WingoRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  betType   WingoBetType
  value     Int?
  amount    BigInt
  payout    BigInt       @default(0)
  state     RoundState   @default(ACTIVE)
  createdAt DateTime     @default(now())
  endedAt   DateTime?

  @@index([userId])
  @@index([roundId, state])
  @@index([roundId, userId])
}

// Landscape WinGo Lottery (dedicated table — separate from portrait WinGo).
enum LotteryBetType {
  number
  green
  red
  violet
}

model LotteryRound {
  id            String         @id @default(cuid())
  period        String         @unique
  phase         WingoPhase     @default(BETTING)
  resultNumber  Int?
  forcedResult  Int?
  bettingEndsAt DateTime
  lockedEndsAt  DateTime?
  revealEndsAt  DateTime?
  createdAt     DateTime       @default(now())
  bets          LotteryBet[]

  @@index([phase])
  @@index([createdAt])
}

model LotteryBet {
  id        String         @id @default(cuid())
  roundId   String
  round     LotteryRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  betType   LotteryBetType
  value     Int?
  amount    BigInt
  payout    BigInt         @default(0)
  state     RoundState     @default(ACTIVE)
  createdAt DateTime       @default(now())
  endedAt   DateTime?

  @@index([userId])
  @@index([roundId, state])
  @@index([roundId, userId])
  @@index([createdAt])
}

// Shared multiplayer European roulette (server-authoritative).
enum RouletteBetType {
  straight
  red
  black
  odd
  even
  low
  high
  dozen
  column
}

model RouletteRound {
  id            String        @id @default(cuid())
  period        String        @unique
  phase         WingoPhase    @default(BETTING)
  resultNumber  Int?
  forcedResult  Int?
  bettingEndsAt DateTime
  lockedEndsAt  DateTime?
  revealEndsAt  DateTime?
  createdAt     DateTime      @default(now())
  bets          RouletteBet[]

  @@index([phase])
  @@index([createdAt])
}

model RouletteBet {
  id        String          @id @default(cuid())
  roundId   String
  round     RouletteRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  betType   RouletteBetType
  value     Int?
  cellKey   String
  amount    BigInt
  payout    BigInt          @default(0)
  state     RoundState      @default(ACTIVE)
  createdAt DateTime        @default(now())
  endedAt   DateTime?

  @@index([userId])
  @@index([roundId, state])
  @@index([roundId, userId])
  @@index([createdAt])
}

// Shared multiplayer Car Roulette (eight fictional marques).
enum CarRouletteBrand {
  zephyra
  kavaro
  nordheim
  ashlyne
  taurion
  regalis
  scudera
  vornik
}

model CarRouletteRound {
  id            String            @id @default(cuid())
  period        String            @unique
  phase         WingoPhase        @default(BETTING)
  resultBrand   CarRouletteBrand?
  resultSlot    Int?
  bettingEndsAt DateTime
  lockedEndsAt  DateTime?
  revealEndsAt  DateTime?
  createdAt     DateTime          @default(now())
  bets          CarRouletteBet[]

  @@index([phase])
  @@index([createdAt])
}

model CarRouletteBet {
  id        String             @id @default(cuid())
  roundId   String
  round     CarRouletteRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  brand     CarRouletteBrand
  amount    BigInt
  payout    BigInt             @default(0)
  state     RoundState         @default(ACTIVE)
  createdAt DateTime           @default(now())
  endedAt   DateTime?

  @@index([userId])
  @@index([roundId, state])
  @@index([roundId, userId])
  @@index([createdAt])
}

// Shared multiplayer Zoo Roulette (wildlife betting table).
enum ZooRouletteAnimal {
  monkey
  rabbit
  lion
  panda
  swallow
  pigeon
  peacock
  eagle
  shark
  golden_frog
}

enum ZooRouletteZone {
  monkey
  rabbit
  lion
  panda
  swallow
  pigeon
  peacock
  eagle
  shark
  beast
  bird
}

model ZooRouletteRound {
  id            String             @id @default(cuid())
  period        String             @unique
  phase         WingoPhase         @default(BETTING)
  resultAnimal  ZooRouletteAnimal?
  resultSlot    Int?
  bettingEndsAt DateTime
  lockedEndsAt  DateTime?
  revealEndsAt  DateTime?
  createdAt     DateTime           @default(now())
  bets          ZooRouletteBet[]

  @@index([phase])
  @@index([createdAt])
}

model ZooRouletteBet {
  id        String           @id @default(cuid())
  roundId   String
  round     ZooRouletteRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  zone      ZooRouletteZone
  amount    BigInt
  payout    BigInt           @default(0)
  state     RoundState       @default(ACTIVE)
  createdAt DateTime         @default(now())
  endedAt   DateTime?

  @@index([userId])
  @@index([roundId, state])
  @@index([roundId, userId])
  @@index([createdAt])
}

// Shared multiplayer Dragon Tiger (dragon / tiger / tie).
enum DragonTigerSide {
  dragon
  tiger
  tie
}

model DragonTigerRound {
  id            String           @id @default(cuid())
  period        String           @unique
  phase         WingoPhase       @default(BETTING)
  winner        DragonTigerSide?
  dragonRank    String?
  dragonSuit    String?
  tigerRank     String?
  tigerSuit     String?
  forcedWinner  DragonTigerSide?
  bettingEndsAt DateTime
  lockedEndsAt  DateTime?
  revealEndsAt  DateTime?
  createdAt     DateTime         @default(now())
  bets          DragonTigerBet[]

  @@index([phase])
  @@index([createdAt])
}

model DragonTigerBet {
  id        String           @id @default(cuid())
  roundId   String
  round     DragonTigerRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  side      DragonTigerSide
  amount    BigInt
  payout    BigInt           @default(0)
  state     RoundState       @default(ACTIVE)
  createdAt DateTime         @default(now())
  endedAt   DateTime?

  @@index([userId])
  @@index([roundId, state])
  @@index([roundId, userId])
}

// Shared multiplayer 7 Up Down (down / seven / up).
enum SevenUpSide {
  down
  seven
  up
}

model SevenUpRound {
  id            String       @id @default(cuid())
  period        String       @unique
  phase         WingoPhase   @default(BETTING)
  die1          Int?
  die2          Int?
  sum           Int?
  forcedSum     Int?
  bettingEndsAt DateTime
  lockedEndsAt  DateTime?
  revealEndsAt  DateTime?
  createdAt     DateTime     @default(now())
  bets          SevenUpBet[]

  @@index([phase])
  @@index([createdAt])
}

model SevenUpBet {
  id        String       @id @default(cuid())
  roundId   String
  round     SevenUpRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  side      SevenUpSide
  amount    BigInt
  payout    BigInt       @default(0)
  state     RoundState   @default(ACTIVE)
  createdAt DateTime     @default(now())
  endedAt   DateTime?

  @@index([userId])
  @@index([roundId, state])
  @@index([roundId, userId])
}

// ------------------------------------------------------------------
// Settings & audit
// ------------------------------------------------------------------
// A marketing channel/line owned by a mentor. Members share links under this channel.
model Channel {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  ownerId   String
  owner     User     @relation("ChannelOwner", fields: [ownerId], references: [id])
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([ownerId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String?
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
}

/// One-time / limited gift codes (Account Records → GIFT CODE)
model GiftCode {
  id        String   @id @default(cuid())
  code      String   @unique
  amount    BigInt
  maxUses   Int      @default(1)
  usedCount Int      @default(0)
  enabled   Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  redemptions GiftCodeRedemption[]
}

model GiftCodeRedemption {
  id         String   @id @default(cuid())
  codeId     String
  code       GiftCode @relation(fields: [codeId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amount     BigInt
  createdAt  DateTime @default(now())

  @@unique([codeId, userId])
  @@index([userId])
}
