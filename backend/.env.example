# Production example — copy to .env and replace all secrets
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=https://play.yourdomain.com,https://admin.yourdomain.com,https://agent.yourdomain.com

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zee9?schema=public"

# Redis (optional)
REDIS_URL="redis://localhost:6379"

# Auth — generate strong random secrets for production
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
